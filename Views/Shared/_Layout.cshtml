<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Young_snakes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    
</head>

<body>
    <header class="mb-4">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-hockey shadow-sm">

            <div class="container-fluid">

                <!-- BRAND -->
                <a class="navbar-brand brand-hockey" asp-controller="Home" asp-action="Index">
                    <span class="brand-y">Y</span>
                    <span class="brand-snakes">SNAKES</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- LEFT MENU -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav-hockey">

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AdminTournaments" asp-action="Index">
                                        Tornei
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AdminDietaryTags" asp-action="Index">
                                        Parametri
                                    </a>
                                </li>                                
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AdminUsers" asp-action="Index">
                                        Utenti
                                    </a>
                                </li>                                
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AdminTeamExpenses" asp-action="Index">
                                        Costi
                                    </a>
                                </li>
                                
                            }

                            @if (User.IsInRole("TeamUser"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Teams" asp-action="Dashboard">
                                        My Team
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- RIGHT MENU -->
                    <ul class="navbar-nav ms-auto align-items-center">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3">
                                <span class="user-tag">
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item me-2">
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-hockey-outline">
                                        Logout
                                    </button>
                                </form>
                            </li>

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-hockey" asp-controller="Auth" asp-action="Register">
                                        Register
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-hockey-outline" asp-controller="Auth" asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light border-top border-secondary pt-5 pb-3 mt-5">
    <div class="container">
        <div class="row g-4">
            
            <div class="col-sm-12 col-md-6 col-lg-4 text-start">
                <h5 class="text-uppercase fw-bold text-white mb-3 border-start border-3 border-danger ps-2">
                    Young Snakes
                </h5>
                <p class="text-white small lh-base">
                    Tornei giovanili internazionali organizzati da <strong>GDT Bellinzona</strong>. Promuoviamo i valori dello sport, del fair play e dell'alto livello competitivo sul ghiaccio.
                </p>
                <div class="d-flex gap-2 mt-3">
                    <a href="https://www.facebook.com" target="_blank" class="btn btn-outline-light btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="https://www.instagram.com" target="_blank" class="btn btn-outline-light btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="mailto:info@youngsnakes.ch" class="btn btn-outline-light btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-envelope-fill"></i>
                    </a>
                </div>
            </div>

            <div class="col-6 col-md-3 col-lg-2 text-start">
                <h6 class="text-uppercase fw-bold text-white mb-3">Link Utili</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white text-decoration-none text-white-hover">Home</a>
                    </li>
                    <li class="mb-2">
                        <a href="https://youngsnakes.ch/en/" target="_blank" class="text-white text-decoration-none text-white-hover">Official Website</a>
                    </li>                    
                </ul>
            </div>

            <div class="col-sm-12 col-md-12 col-lg-3 text-start">
                <h6 class="text-uppercase fw-bold text-white mb-3">Location</h6>
                <p class="text-white small m-0">
                    <i class="bi bi-geo-alt-fill text-danger me-2"></i> Centro Sportivo Bellinzona<br>
                    Via Francesco Chiesa 4<br>
                    6500 Bellinzona, Svizzera
                </p>
                <div class="mt-3 bg-secondary bg-opacity-25 p-2 rounded border border-secondary border-opacity-50">
                    <span class="text-white small fw-bold d-block"><i class="bi bi-info-circle me-1 text-danger"></i> Stato Pista</span>
                    <small class="text-white" style="font-size: 0.75rem;">Ghiaccio al coperto operativo per i tornei.</small>
                </div>
            </div>

        </div>

        <hr class="my-4 border-secondary opacity-25">

        <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                <span class="text-white small">
                    &copy; 2026 - <strong>Young Snakes</strong>. Tutti i diritti riservati. Organizzato da GDT Bellinzona.
                </span>
            </div>
            <div class="col-md-6 text-center text-md-end">
                <span class="text-white small" style="font-size: 0.75rem;">
                    Sviluppato in conformità con ASP.NET Core MVC
                </span>
            </div>
        </div>
    </div>
</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>