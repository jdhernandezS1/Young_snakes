@model Young_snakes.Models.ViewModels.CateringManagementViewModel

@{
    ViewData["Title"] = "Configurazione Catering";
}

<div class="container py-4">
    <!-- Encabezado Principal -->
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <h1 class="display-6 mb-0">Gestione <span class="fw-bold">Catering</span></h1>
            <p class="text-muted mb-0">Configurazione pasti e restrizioni alimentari.</p>
        </div>
        <div class="btn-group">
            <a href="#pasti-section" class="btn btn-outline-secondary btn-sm">Pasti</a>
            <a href="#diete-section" class="btn btn-outline-secondary btn-sm">Diete</a>
        </div>
    </div>

    <!-- SECCIÓN 1: MENÚ PASTI -->
    <section id="pasti-section" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-egg-fried fs-2 text-primary me-3"></i>
                <h2 class="h3 mb-0">Menù Pasti</h2>
            </div>
            <a asp-controller="AdminMeals" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Aggiungi Pasto
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Descrizione</th>
                            <th class="text-center">Prezzo</th>
                            <th class="text-end pe-4">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Meals)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.MealName</td>
                                <td class="text-center">
                                    <span class="badge bg-success text-white">
                                        CHF @item.Price.ToString("F2")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-controller="AdminMeals" asp-action="Edit" asp-route-id="@item.IdMeal" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="AdminMeals" asp-action="Delete" asp-route-id="@item.IdMeal" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: ALLERGENI E DIETE -->
    <section id="diete-section">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle text-warning fs-2 me-3"></i>
                <h2 class="h3 mb-0">Allergeni e Diete</h2>
            </div>
            <a asp-controller="AdminDietaryTags" asp-action="Create" class="btn btn-warning text-dark fw-bold">
                <i class="bi bi-plus-lg"></i> Nuova Etichetta
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nome Tag</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-end pe-4">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DietaryTags)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.TagName</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @item.TagType
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-controller="AdminDietaryTags" asp-action="Edit" asp-route-id="@item.IdTag" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="AdminDietaryTags" asp-action="Delete" asp-route-id="@item.IdTag" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>