@model Young_snakes.Models.Accommodation

@{
    ViewData["Title"] = "Elimina Alloggio";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h3 class="card-title h5 mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Elimina Alloggio
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning mb-4">
                        <h5 class="alert-heading fw-bold small text-uppercase">Sei sicuro de voler eliminare questo alloggio?</h5>
                        <p class="mb-0 small text-muted">Questa azione rimuoverà definitivamente la struttura dal sistema.</p>
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted small text-uppercase">Nome Alloggio:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.AccommodationName</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Tipo:</dt>
                        <dd class="col-sm-8">@Model.AccommodationType</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Prezzo:</dt>
                        <dd class="col-sm-8 text-success fw-bold">CHF @Model.PricePerNight.ToString("F2")</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdAccommodation" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Annulla
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-1"></i> Elimina Definitivamente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>