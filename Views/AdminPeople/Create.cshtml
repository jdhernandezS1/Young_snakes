@model Person

@{
    ViewData["Title"] = "Add New Member";
}

<h1>Create</h1>
<h4>Adding person to Team ID: @Model.IdTeam</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            
            <input type="hidden" asp-for="IdTeam" />

            <div class="form-group mb-3">
                <label asp-for="FirstName" class="control-label">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LastName" class="control-label">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="BirthDate" class="control-label">Birth Date</label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Height" class="control-label">Height (cm)</label>
                    <input asp-for="Height" class="form-control" />
                    <span asp-validation-for="Height" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Phone" class="control-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Maglia" class="control-label">Jersey Number</label>
                    <input asp-for="Maglia" class="form-control" />
                    <span asp-validation-for="Maglia" class="text-danger"></span>
                </div>
            </div>

            
            <div class="form-group mb-4">
                <label asp-for="IdRole" class="control-label">Role in Team</label>
                <select asp-for="IdRole" class="form-control" asp-items="ViewBag.IdRole">
                    <option value="">-- Select Role --</option>
                </select>
                <span asp-validation-for="IdRole" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Person" class="btn btn-primary w-100" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="AdminTeams asp-action="Edit" asp-route-teamId="@Model.IdTeam">Back to Team List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}