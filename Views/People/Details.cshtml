@model Person
@{
    ViewData["Title"] = "Player Details";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4 bg-dark text-white rounded-3">

        <h2 class="mb-3">🏒 Player Profile</h2>
        <hr class="bg-light" />

        <div class="row">
            <div class="col-md-6">
                <p><strong>First Name:</strong> @Model.FirstName</p>
                <p><strong>Last Name:</strong> @Model.LastName</p>
                <p><strong>Birth Date:</strong> @Model.BirthDate</p>
                <p><strong>Height:</strong> @Model.Height cm</p>
            </div>

            <div class="col-md-6">
                <p><strong>Phone:</strong> @Model.Phone</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Jersey #:</strong> @Model.Maglia</p>
                <p><strong>Team ID:</strong> @Model.IdTeam</p>
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-light rounded-3 p-2 me-3 text-center" style="width: 40px;">
                        @if (Model.Gender == 1)
                        {
                            <i class="bi bi-gender-male text-primary"></i>
                        }
                        else
                        {
                            <i class="bi bi-gender-female text-danger"></i>
                        }
                    </div>
                    <div>
                        <label class="small text-muted text-uppercase d-block">Gender</label>
                        <span class="fw-semibold">
                            @(Model.Gender == 1 ? "Male" : "Female")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.IdPerson" class="btn btn-outline-light">
                Edit Player
            </a>
            <a asp-controller="Teams" asp-action="Dashboard" class="btn btn-light">Back</a>

        </div>

    </div>
</div>