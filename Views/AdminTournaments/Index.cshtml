@model IEnumerable<Young_snakes.Models.Tournament>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">Gestione Tornei e Squadre</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-2"></i>Aggiungi Torneo
        </a>
    </div>

    @foreach (var tournament in Model)
    {
        <!-- Obtenemos todos los nombres de roles únicos para este torneo para armar el header -->
        var todosLosRoles = tournament.Teams
            .SelectMany(t => t.Persons)
            .Where(p => p.Role != null)
            .Select(p => p.Role.RoleName)
            .Distinct()
            .OrderByDescending(r => r.ToLower().Contains("player") || r.ToLower().Contains("goalkeeper"))
            .ToList();

        <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
            <div class="card-header bg-dark py-3 px-4 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold text-white">@tournament.TournamentName</h5>
                    <span class="badge bg-primary">@tournament.CategoryName</span>
                    <span class="text-white-50 small ms-2">Min. richiesto: @tournament.MinPlayers (GK + Player)</span>
                </div>
                <div class="btn-group">
                    <a asp-controller="AdminReports" asp-action="TournamentRosterPdf"
                           asp-route-id="@tournament.IdTournament" class="btn btn-sm btn-danger">
                        <i class="bi bi-file-pdf me-1"></i>Report PDF
                    </a>
                    <a asp-action="Edit" asp-route-id="@tournament.IdTournament"
                           class="btn btn-sm btn-outline-light ms-2 rounded-pill">
                        <i class="bi bi-gear"></i>
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Squadra & Dettagli</th>
                            <th class="text-center">Logistica</th>
                            <th class="text-center">Stato Rosa</th>
                            @foreach (var roleName in todosLosRoles)
                            {
                                <th class="text-center">@roleName</th>
                            }
                            <th class="text-center">Extra (Fee)</th>
                            <th class="text-end pe-4">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in tournament.Teams)
                        {
                            var playersCount = team.Persons.Count(p =>
                                p.Role?.RoleName.ToLower().Contains("player") == true ||
                                p.Role?.RoleName.ToLower().Contains("goalkeeper") == true);

                            var estaCompleto = playersCount >= tournament.MinPlayers;
                            var extraPlayers = playersCount > tournament.MaxPlayers ? playersCount - tournament.MaxPlayers : 0;

                            <tr>
                                <!-- Nombre y Logo -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            @if (!string.IsNullOrEmpty(team.TeamImageUrl))
                                            {
                                                <img src="@team.TeamImageUrl" class="rounded shadow-sm"
                                                     style="width: 45px; height: 45px; object-fit: cover;" alt="Logo" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center border"
                                                     style="width: 45px; height: 45px;">
                                                    <i class="bi bi-shield-slash text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@team.TeamName</div>
                                            <div class="small text-muted" style="font-size: 0.75rem;">
                                                <i class="bi bi-person me-1"></i>@team.User?.UserName
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Logística: Alojamiento y Transporte -->
                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        @if (team.Accommodation != null)
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle w-100"
                                                  title="Alloggio">
                                                <i class="bi bi-house-door me-1"></i> @team.Accommodation.AccommodationName
                                            </span>
                                        }
                                        @if (team.Mezzo != null)
                                        {
                                            <span
                                                class="badge bg-secondary-subtle text-secondary border border-secondary-subtle w-100"
                                                title="Trasporto">
                                                <i class="bi bi-bus-front me-1"></i> @team.Mezzo.Veicolo
                                            </span>
                                        }
                                        @if (team.Sponsors.Any())
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle w-100">
                                                <i class="bi bi-star-fill me-1"></i> @team.Sponsors.Count Sponsors
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Estado de la Rosa -->
                                <td class="text-center">
                                    @if (estaCompleto)
                                    {
                                        <span
                                            class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3">
                                            <i class="bi bi-check-circle-fill"></i> OK
                                        </span>
                                    }
                                    else
                                    {
                                        <span
                                            class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3">
                                            @playersCount / @tournament.MinPlayers
                                        </span>
                                    }
                                </td>

                                <!-- Cantidades dinámicas por Rol -->
                                @foreach (var roleName in todosLosRoles)
                                {
                                    var count = team.Persons.Count(p => p.Role?.RoleName == roleName);
                                    <td class="text-center">
                                        <span class="@(count > 0 ? "fw-bold text-dark" : "text-muted opacity-25")">
                                            @(count > 0 ? count.ToString() : "-")
                                        </span>
                                    </td>
                                }

                                <!-- Extra Players Fee -->
                                <td class="text-center">
                                    @if (extraPlayers > 0)
                                    {
                                        <div class="text-danger fw-bold" style="font-size: 0.85rem;">
                                            + @extraPlayers Ext
                                        </div>
                                        <div class="small text-muted" style="font-size: 0.7rem;">
                                            CHF @(extraPlayers* tournament.ExtraPlayerFee)
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }

                                </td>

                                <!-- Acciones -->
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-none border rounded-3 bg-white">
                                        <a asp-controller="AdminTeams" asp-action="Edit" asp-route-id="@team.IdTeam"
                                               class="btn btn-link text-primary btn-sm border-end" title="Modifica">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="AdminReports" asp-action="TeamRosterPdf" asp-route-id="@team.IdTeam"
                                               class="btn btn-link text-danger btn-sm" title="Scarica PDF">
                                            <i class="bi bi-file-pdf"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>